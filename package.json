{
  "name": "cowatch-backend",
  "version": "1.0.0",
  "description": "CoWatch 游戏复盘网站后端服务",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc",
    "start": "node dist/app.js",
    "type-check": "tsc --noEmit",
    "db:reset": "rimraf database/cowatch.sqlite3 database/cowatch.sqlite3-shm database/cowatch.sqlite3-wal uploads/cowatch && echo '✅ 数据库 + HLS 切片已清空，重启后端后自动重建'"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ali-oss": "^6.21.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "tsx": "^4.1.0",
    "typescript": "5.7.3"
  }
}
