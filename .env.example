PORT=3002
NODE_ENV=development

# PostgreSQL 连接字符串
# 本地开发：先启动 docker-compose -f docker-compose.local.yml up postgres
# 或使用本地 PostgreSQL 实例
DATABASE_URL=postgresql://cowatch:dev@localhost:5432/cowatch

# JWT 密钥（生产环境请换成高强度随机字符串）
JWT_SECRET=your-jwt-secret

# CORS 白名单（多个域名用逗号分隔）
CORS_ORIGIN=http://localhost:3001

# COS 配置（腾讯云）
# 本地开发时无需填写，留空即自动走本地文件存储模式（uploads/ 目录）
# 生产环境填写以下变量后自动切换为 COS 模式
#
# ⚠️  地域一致性要求：COS_REGION 必须与服务器所在地域相同（当前服务器：上海 ap-shanghai）
#     - 服务器→COS 上传：同地域走内网，速度 100x+（~500Mbps），跨地域走公网仅 ~4Mbps
#     - CDN 回源：CDN 控制台的回源地址也必须指向同一 Bucket
#
# COS_REGION=ap-shanghai
# COS_BUCKET=co-watch-xxxxxxxx
# COS_SECRET_ID=your-secret-id
# COS_SECRET_KEY=your-secret-key
#
# 视频文件 URL 前缀（接入 CDN 后填 CDN 域名，否则留空使用 COS 默认域名）
# COS_BASE_URL=https://your-cdn-domain.com
#
# CDN TypeA 鉴权密钥（腾讯云 CDN 控制台「访问控制 → 鉴权配置 → TypeA」里的主 KEY）
# 填写后视频 URL 自动加签，防止 URL 泄露后被持续访问；不填则走 COS 直连签名
# CDN_AUTH_KEY=your-cdn-auth-key
#
# static 桶配置（public read，用于头像存储）
# 与视频桶共用同一对 SecretId/SecretKey 和 COS_REGION（两桶同地域）
# 本地开发不填则降级为本地 uploads/avatar/ 文件存储
# COS_STATIC_BUCKET=cowatch-static-xxxxxxxx
# COS_STATIC_URL=https://static.your-domain.com
#
# 注意：COS 内网加速已在代码中硬编码开启（ossService.ts）
# 前提：服务器与 Bucket 必须在同一腾讯云地域（当前均为上海 ap-shanghai）
